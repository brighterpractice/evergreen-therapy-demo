---
import Button from './Button.astro'; import {navigation} from '../data/navigation'; import {appointmentUrl,clientPortalUrl,externalLinkAttrs} from '../data/site'; const path=Astro.url.pathname; const portalAttrs=externalLinkAttrs();
---
<header class="site-header"><div class="container header-inner"><a class="brand" href="/" aria-label="Evergreen Counseling Collective home"><img class="brand-mark" src="/images/branding/evergreen-mark.png" width="96" height="96" alt="" fetchpriority="high"/><img class="brand-wordmark" src="/images/branding/evergreen-wordmark.png" width="360" height="101" alt="" fetchpriority="high"/></a><nav class="desktop-nav" aria-label="Primary navigation"><a href="/" aria-current={path==='/'?'page':undefined}>Home</a>{navigation.map(item=><details><summary class:list={{active:path.startsWith(item.href)}}>{item.label}</summary><div class:list={['nav-panel',item.label==='Services'&&'nav-panel--wide']}>{item.children.map(child=><a href={child.href} aria-current={path===child.href?'page':undefined}>{child.label}</a>)}</div></details>)}</nav><div class="actions"><a class="portal" href={clientPortalUrl} target={portalAttrs.target} rel={portalAttrs.rel} data-bs-analytics-event="client_portal_click">Client Portal</a><Button href={appointmentUrl} tracking="request-appointment">Request appointment</Button></div><details class="mobile-nav"><summary aria-label="Open navigation"><span></span><span></span><span></span></summary><nav aria-label="Mobile navigation"><a href="/" aria-current={path==='/'?'page':undefined}>Home</a>{navigation.map(item=>item.label==='About'?<div class="mobile-group"><p class="mobile-section-label">About</p>{item.children.map(child=><a href={child.href} aria-current={path===child.href?'page':undefined}>{child.label}</a>)}</div>:(item.label==='Services'||item.label==='Approaches')?<div class="mobile-group"><div class="mobile-row"><a class:list={['mobile-parent',{active:path.startsWith(item.href)}]} href={item.href} aria-current={path===item.href?'page':undefined}>{item.label}</a><button type="button" class="mobile-subtoggle" aria-expanded={path.startsWith(item.href)?'true':'false'} aria-controls={`mobile-${item.label.toLowerCase().replace(/\s+/g,'-')}-panel`} aria-label={`Toggle ${item.label.toLowerCase()} list`}><span class="chevron" aria-hidden="true"></span></button></div><div class="mobile-subpanel" id={`mobile-${item.label.toLowerCase().replace(/\s+/g,'-')}-panel`} hidden={!path.startsWith(item.href)}>{item.children.slice(1).map(child=><a href={child.href} aria-current={path===child.href?'page':undefined}>{child.label}</a>)}</div></div>:<div class="mobile-group"><a class:list={['mobile-parent',{active:path.startsWith(item.href)}]} href={item.href} aria-current={path===item.href?'page':undefined}>{item.label}</a>{item.children.slice(1).map(child=><a href={child.href} aria-current={path===child.href?'page':undefined}>{child.label}</a>)}</div>)}<a href={clientPortalUrl} target={portalAttrs.target} rel={portalAttrs.rel} data-bs-analytics-event="client_portal_click">Client Portal</a></nav></details></div></header>
<style>
.site-header{position:sticky;top:0;z-index:50;border-bottom:1px solid rgba(112,135,125,.2);background:rgba(255,253,249,.94);backdrop-filter:blur(14px)}.header-inner{display:flex;min-height:4.8rem;align-items:center;justify-content:space-between;gap:1rem}.brand{display:flex;min-width:0;min-height:44px;align-items:center;gap:.45rem;color:var(--ink);text-decoration:none}.brand img{display:block;flex:0 0 auto}.brand-mark{width:3rem;height:auto}.brand-wordmark{width:9.3rem;height:auto}.desktop-nav,.actions{display:none}.mobile-nav{flex:0 0 auto}.mobile-nav>summary{display:grid;width:3rem;height:3rem;cursor:pointer;list-style:none;place-content:center;gap:5px}.mobile-nav>summary::-webkit-details-marker{display:none}.mobile-nav>summary span{width:1.45rem;height:2px;background:var(--ink)}.mobile-nav nav{position:absolute;top:100%;left:0;width:100%;max-width:100vw;max-height:calc(100dvh - 4.8rem);overflow:auto;overscroll-behavior:contain;padding:1rem 1.25rem calc(1.5rem + env(safe-area-inset-bottom));border-bottom:1px solid var(--sand);background:var(--paper)}.mobile-nav a{display:flex;min-height:44px;align-items:center;padding:.45rem .3rem;color:var(--ink);font-weight:650;text-decoration:none}.mobile-section-label{display:flex;min-height:44px;align-items:center;margin:0;padding:.45rem .3rem;color:var(--ink);font-weight:650}.mobile-nav a[aria-current="page"],.mobile-parent.active{color:var(--clay-text)}.mobile-group{padding-block:.3rem;border-top:1px solid var(--sand)}.mobile-group a:not(.mobile-parent){padding-left:1.25rem;color:var(--body);font-size:.93rem;font-weight:500}.mobile-group a[aria-current="page"]{color:var(--clay-text)}.mobile-row{display:flex;align-items:center;gap:.25rem}.mobile-row .mobile-parent{flex:1 1 auto}.mobile-subtoggle{display:grid;flex:0 0 auto;width:44px;height:44px;place-content:center;color:var(--ink);background:none;border:0;cursor:pointer}.mobile-subtoggle .chevron{display:block;width:.55rem;height:.55rem;border-right:2px solid currentColor;border-bottom:2px solid currentColor;transform:rotate(45deg);transition:transform .2s ease}.mobile-subtoggle[aria-expanded="true"] .chevron{transform:rotate(-135deg)}.mobile-subpanel{display:grid;gap:.05rem;padding-bottom:.35rem}.mobile-subpanel[hidden]{display:none}.mobile-subpanel a{padding-left:1.25rem;color:var(--body);font-size:.93rem;font-weight:500}.mobile-subpanel a[aria-current="page"]{color:var(--clay-text)}
@media(min-width:64rem){.brand-mark{width:3.2rem;height:auto}.brand-wordmark{width:10rem}.mobile-nav{display:none}.desktop-nav,.actions{display:flex;align-items:center}.desktop-nav{gap:.3rem;margin-left:auto}.desktop-nav>a,.desktop-nav summary{padding:.8rem .65rem;color:var(--ink);font-size:.88rem;font-weight:700;text-decoration:none}.desktop-nav details{position:relative}.desktop-nav summary{cursor:pointer;list-style:none}.desktop-nav summary:after{content:"⌄";margin-left:.35rem;color:var(--sage)}.desktop-nav summary::-webkit-details-marker{display:none}.desktop-nav .active,.desktop-nav [aria-current=page]{color:var(--clay-text)}.nav-panel{position:absolute;top:100%;left:50%;display:grid;width:max-content;min-width:15rem;max-width:21rem;padding:.65rem;border:1px solid var(--sand);border-radius:var(--radius);background:white;box-shadow:var(--shadow);transform:translateX(-50%)}.nav-panel--wide{grid-template-columns:repeat(2,1fr);width:32rem;max-width:70vw}.nav-panel a{padding:.55rem .7rem;border-radius:.4rem;color:var(--body);font-size:.86rem;line-height:1.3;text-decoration:none}.nav-panel a:hover{background:var(--cream);color:var(--moss)}.actions{gap:1rem}.portal{color:var(--ink);font-size:.86rem;font-weight:750;white-space:nowrap}}
</style>
