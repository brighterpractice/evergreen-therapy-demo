---
import Button from './Button.astro';
import { navigation } from '../data/navigation';
import { appointmentUrl, clientPortalUrl, externalLinkAttrs } from '../data/site';

const path = Astro.url.pathname;
const portalAttrs = externalLinkAttrs();
---

<header class="site-header">
  <div class="container header-inner">

    <a class="brand" href="/" aria-label="Evergreen Counseling Collective home">
      <span class="evergreen-wordmark">
        <span class="evergreen-name">Evergreen</span>
        <span class="evergreen-subname">Counseling Collective</span>
      </span>
    </a>

    <nav
      class="desktop-nav"
      aria-label="Primary navigation"
      data-track="primary-navigation"
    >
      <a
        href="/"
        aria-current={path === '/' ? 'page' : undefined}
      >
        Home
      </a>

      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={
              path === item.href || path.startsWith(item.href)
                ? 'page'
                : undefined
            }
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <a
        class="portal"
        href={clientPortalUrl}
        target={portalAttrs.target}
        rel={portalAttrs.rel}
        data-track="client-portal"
      >
        Client Portal
      </a>

      <Button
        href={appointmentUrl}
        tracking="request-appointment"
      >
        Request appointment
      </Button>
    </div>

    <details class="mobile-nav">
      <summary aria-label="Open navigation">
        <span></span>
        <span></span>
        <span></span>
      </summary>

      <nav
        aria-label="Mobile navigation"
        data-track="mobile-navigation"
      >
        <a
          href="/"
          aria-current={path === '/' ? 'page' : undefined}
        >
          Home
        </a>

        {
          navigation.map((item) => (
            <a
              href={item.href}
              aria-current={
                path === item.href || path.startsWith(item.href)
                  ? 'page'
                  : undefined
              }
            >
              {item.label}
            </a>
          ))
        }

        <a
          href={clientPortalUrl}
          target={portalAttrs.target}
          rel={portalAttrs.rel}
          data-track="client-portal"
        >
          Client Portal
        </a>
      </nav>
    </details>

  </div>
</header>
