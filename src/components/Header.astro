---
import Button from './Button.astro';
import { navigation } from '../data/navigation';
import { appointmentUrl } from '../data/site';

const path = Astro.url.pathname;

const isActive = (href: string) =>
  href === '/'
    ? path === '/'
    : path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">

    <a class="brand" href="/" aria-label="Evergreen Counseling Collective home">
      <span class="brand-mark" aria-hidden="true">E</span>

      <span class="brand-text">
        <strong>Evergreen</strong>
        <span>Counseling Collective</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class:list={{ active: isActive(item.href) }}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <Button href={appointmentUrl} tracking="request-appointment">
        Request appointment
      </Button>
    </div>

    <details class="mobile-nav">
      <summary aria-label="Open navigation">
        <span></span>
        <span></span>
        <span></span>
      </summary>

      <nav aria-label="Mobile navigation">
        {
          navigation.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }

        <a class="mobile-cta" href={appointmentUrl}>
          Request appointment
        </a>
      </nav>
    </details>

  </div>
</header>
