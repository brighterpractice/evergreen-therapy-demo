---
import { practice } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">

    <div class="footer-brand">
      <p class="footer-name">{practice.name}</p>
      <p>
        Thoughtful counseling for individuals, couples, and families.
      </p>
    </div>

    <div>
      <p class="footer-heading">Explore</p>
      <nav aria-label="Footer navigation">
        <a href="/services/">Services</a>
        <a href="/about/">Our Team</a>
        <a href="/approaches/">Approach</a>
        <a href="/contact/">Contact</a>
      </nav>
    </div>

    <div>
      <p class="footer-heading">Practice</p>
      <p>{practice.city}, {practice.state}</p>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </div>

  </div>

  <div class="container footer-bottom">
    <p>© {year} {practice.name}</p>
    <p class="demo-notice">
      Demonstration website — fictional practice and clinicians.
    </p>
  </div>
</footer>
