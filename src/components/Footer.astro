---
import {appointmentUrl,clientPortalUrl,practice,externalLinkAttrs} from '../data/site';
const appointmentAttrs = externalLinkAttrs();
const portalAttrs = externalLinkAttrs();
---
<footer><div class="container footer-grid"><div><p class="name">{practice.name}</p><p>A private counseling practice in {practice.city}, {practice.state}.</p></div><div><h2>Explore</h2><a href="/about/">About</a><a href="/services/">Services</a><a href="/contact/">Contact</a></div><div><h2>Connect</h2><a href={appointmentUrl} target={appointmentAttrs.target} rel={appointmentAttrs.rel} data-bs-analytics-event="appointment_click">Request appointment</a><a href={clientPortalUrl} target={portalAttrs.target} rel={portalAttrs.rel} data-bs-analytics-event="client_portal_click">Client Portal</a></div><div class="demo-note"><h2>Demo website</h2><p>Evergreen Counseling Collective and Maya Bennett are fictional and are presented as a design demonstration by Brighter Sites.</p><a href="https://brightersites.app/work/" target="_blank" rel="noopener noreferrer">View Brighter Sites →</a></div></div><div class="container legal"><span>© {new Date().getFullYear()} {practice.name}</span><span>{practice.city}, {practice.state}</span><span class="legal-links"><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></span></div><div class="container brighter-sites-signature">Website built and managed by <a href="https://brightersites.app" target="_blank" rel="noopener noreferrer">Brighter Sites</a></div></footer>
<style>footer{padding:3.5rem 0 calc(5.25rem + env(safe-area-inset-bottom));background:#1f3831;color:#cfdbd6}.footer-grid{display:grid;gap:2rem}.name{color:white;font-family:var(--serif);font-size:1.55rem}footer h2{color:white;font-family:var(--sans);font-size:.75rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}footer a{display:flex;width:fit-content;min-height:44px;align-items:center;color:#e8eeeb;text-decoration:none}footer a:hover{color:white}.legal{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.75rem 1.25rem;margin-top:2.25rem;padding-top:1.25rem;border-top:1px solid rgba(255,255,255,.15);font-size:.8rem}.legal-links{display:flex;gap:1rem}.brighter-sites-signature{margin-top:.7rem;color:#93aaa1;font-size:.68rem;line-height:1.5}.brighter-sites-signature a{display:inline;min-height:0;padding:0;color:#b8c9c2;font-weight:700;text-decoration:underline;text-decoration-color:rgba(255,255,255,.15);text-underline-offset:2px}.brighter-sites-signature a:hover{color:white}@media(min-width:48rem){footer{padding:4rem 0}.footer-grid{grid-template-columns:1.6fr .8fr .8fr 1.4fr;gap:2.5rem}footer a{min-height:0;padding:.2rem 0}.demo-note p{margin:0 0 .6rem;max-width:24rem;color:#cfdbd6;font-size:.86rem;line-height:1.6}.legal{gap:1rem;margin-top:3rem}}</style>
