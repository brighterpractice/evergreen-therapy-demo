---
import Breadcrumbs from './Breadcrumbs.astro'; interface Props{eyebrow?:string;title:string;intro:string;crumbs?:{label:string;href?:string}[]} const {eyebrow,title,intro,crumbs}=Astro.props;
---
<section class="page-hero"><div class="container">{crumbs&&<Breadcrumbs items={crumbs}/>} {eyebrow&&<p class="eyebrow">{eyebrow}</p>}<h1>{title}</h1><p class="intro">{intro}</p></div></section>
<style>.page-hero{position:relative;overflow:hidden;padding:3.25rem 0;background:var(--cream)}.page-hero:after{content:"";position:absolute;right:-7rem;bottom:-8rem;width:20rem;height:20rem;border:1px solid var(--sage);border-radius:50%;opacity:.35}.page-hero h1{max-width:15ch}.intro{max-width:42rem;font-size:var(--lg);line-height:1.55}@media(max-width:47.999rem){.page-hero:after{display:none}}@media(min-width:48rem){.page-hero{padding:clamp(3.5rem,9vw,7rem) 0}.intro{line-height:inherit}}</style>
