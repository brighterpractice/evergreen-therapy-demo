---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { approaches } from '../../data/approaches';
import { breadcrumbSchema, pageSchema } from '../../lib/schema';

const crumbs = [{ label: 'Approaches' }];
---

<Layout
  title="Therapy Approaches in Meridian, Idaho"
  description="Explore therapy approaches Maya Bennett may use in individual counseling, including EMDR, IFS, Somatic Experiencing, EFT, and mindfulness."
  schema={pageSchema([breadcrumbSchema(crumbs, Astro.url.pathname)])}
>
  <PageHero
    eyebrow="How therapy may take shape"
    title="Therapy approaches Maya may draw from."
    intro="Different approaches offer different ways to understand experiences, emotions, patterns, and responses. Maya may use one or more depending on the focus of counseling."
    crumbs={crumbs}
  />

  <section class="section">
    <div class="container grid grid--2">
      <div>
        <p class="eyebrow">Understanding the difference</p>
        <h2>Services describe what may bring you in. Approaches describe ways of working.</h2>
      </div>

      <div>
        <p>
          A concern such as anxiety, grief, trauma, or relationship difficulty
          does not automatically determine one type of therapy. More than one
          approach may be useful at different points in counseling.
        </p>

        <p>
          These pages are here to explain the methods in plain language so you
          can understand what they involve and ask questions if something
          interests you.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <p class="eyebrow">Approaches Maya may use</p>
      <h2>Explore the methods behind the work.</h2>

      <div class="approach-grid">
        {
          approaches.map((approach) => (
            <a
              class="card service-link"
              href={approach.href}
              data-track={`approach-${approach.slug}`}
            >
              <h3>{approach.title}</h3>
              <p>{approach.cardDescription}</p>
              <span class="learn">Learn more →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--2">
      <div>
        <p class="eyebrow">Choosing an approach</p>
        <h2>The method is only one part of therapy.</h2>
      </div>

      <div>
        <p>
          Maya considers the concern being discussed, how a client responds to
          the work, personal preferences, readiness, and what seems useful as
          counseling develops.
        </p>

        <p>
          You can also say when something does not make sense or does not feel
          like a good fit. Therapy can be adjusted as the work continues.
        </p>

        <div class="overview-links">
          <a class="link-arrow" href="/services/">
            Explore areas of support
          </a>

          <a class="link-arrow" href="/about/maya-bennett/">
            Learn more about Lisa
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .approach-grid{
    display:grid;
    gap:.75rem;
    margin-top:2rem
  }

  .approach-grid a{
    display:block;
    text-decoration:none
  }

  .approach-grid h3{
    margin-bottom:.6rem
  }

  .learn{
    display:inline-block;
    margin-top:.5rem;
    color:var(--sage-dark);
    font-size:.9rem;
    font-weight:750
  }

  .overview-links{
    display:grid;
    gap:.5rem;
    margin-top:1.25rem
  }

  @media(min-width:48rem){
    .approach-grid{
      grid-template-columns:repeat(2,1fr)
    }
  }

  @media(min-width:64rem){
    .approach-grid{
      grid-template-columns:repeat(3,1fr)
    }
  }
</style>
