---
import Layout from '../layouts/Layout.astro'; import PageHero from '../components/PageHero.astro'; import Button from '../components/Button.astro'; import {appointmentUrl,clientPortalUrl,externalLinkAttrs} from '../data/site'; import {breadcrumbSchema,pageSchema} from '../lib/schema';
const portalAttrs = externalLinkAttrs();
const crumbs = [{label:'Contact'}];
---
<Layout title="Contact Bright Hope Therapy | Meridian, Idaho" description="Request an individual counseling appointment with Lisa Bright, LCPC, at Bright Hope Therapy in Meridian, Idaho." schema={pageSchema([breadcrumbSchema(crumbs,Astro.url.pathname)])}><PageHero eyebrow="Contact and getting started" title="Take the first step when you are ready." intro="If you are interested in individual counseling with Lisa Bright, LCPC, use the Request Appointment option to begin." crumbs={crumbs}/><section class="section" id="new-clients"><div class="container contact-grid"><div><p class="eyebrow">New clients</p><h2>Begin with an appointment request.</h2><p>Use the Request Appointment option to get started. Information needed for counseling will be collected through the appropriate secure system.</p><p>Please do not send diagnoses, medication information, trauma history, insurance identifiers, or other sensitive clinical details through ordinary contact methods.</p><p class="safety-note">Do not use this website or an appointment request for emergencies or urgent support. If there is immediate danger, contact local emergency services.</p><Button href={appointmentUrl} tracking="request-appointment">Request an appointment</Button></div><aside class="card" id="contact-details"><h2>Bright Hope Therapy</h2><dl><div><dt>Location</dt><dd>Meridian, Idaho</dd></div><div><dt>Existing clients</dt><dd><a href={clientPortalUrl} target={portalAttrs.target} rel={portalAttrs.rel} data-track="client-portal">Open Client Portal</a></dd></div></dl></aside></div></section><section class="section" id="faq"><div class="container measure"><p class="eyebrow">Questions before getting started</p><h2>A few helpful details</h2><details><summary>Where is Bright Hope Therapy located?</summary><p>Bright Hope Therapy is based in Meridian, Idaho.</p></details><details><summary>What kind of counseling is available?</summary><p>Lisa provides individual therapy for adults. The <a href="/services/">services overview</a> describes current areas of support.</p></details><details><summary>Where can I learn more about Lisa?</summary><p>Read about <a href="/about/lisa-bright/">Lisa’s background and approach to counseling</a>.</p></details></div></section></Layout>
<style>.contact-grid{display:grid;gap:2rem}.contact-grid dl{margin:0}.contact-grid dl div{padding:1rem 0;border-top:1px solid var(--sand)}.safety-note{padding-left:1rem;border-left:3px solid var(--clay);font-size:.92rem}dt{color:var(--muted);font-size:.75rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}dd{margin:.2rem 0 0;color:var(--ink)}details{padding:1.25rem 0;border-top:1px solid var(--sand)}summary{cursor:pointer;color:var(--ink);font-weight:750}details p{padding-top:1rem}@media(min-width:48rem){.contact-grid{grid-template-columns:1.2fr .8fr;align-items:start}}</style>
