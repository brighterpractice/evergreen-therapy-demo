---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import {
  personSchema,
  breadcrumbSchema,
  pageSchema,
} from '../../lib/schema';

const crumbs = [
  { label: 'About', href: '/about/' },
  { label: 'Maya Bennett, LPC' },
];
---

<Layout
  title="Maya Bennett, LPC | Fort Collins Counselor"
  description="Meet Maya Bennett, LPC, a fictional counselor at Evergreen Counseling Collective in Fort Collins, Colorado."
  schema={pageSchema([
    personSchema('/about/maya-bennett/'),
    breadcrumbSchema(crumbs, Astro.url.pathname),
  ])}
>
  <PageHero
    eyebrow="Your counselor"
    title="Maya Bennett, LPC"
    intro="Maya offers thoughtful individual therapy for adults who want support navigating stress, change, relationships, and difficult emotional patterns."
    crumbs={crumbs}
  />

  <section class="section bio-section bio-intro">
    <div class="container profile">
      <picture class="photo">
        <img
          src="/images/demo/clinician-placeholder.svg"
          width="700"
          height="780"
          loading="lazy"
          decoding="async"
          alt="Clinician photo placeholder"
        />
      </picture>

      <div>
        <p class="eyebrow">Working with Maya</p>
        <h2>Support that is collaborative, practical, and grounded.</h2>

        <p>
          Maya approaches counseling as a partnership. Sessions create space to
          understand what has been difficult while also identifying practical
          ways to respond differently outside the therapy room.
        </p>

        <p>
          Her style is warm, engaged, and curious. She works with clients to
          notice patterns, clarify priorities, and build approaches that fit
          their individual circumstances rather than following a single formula.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tint bio-section">
    <div class="container grid grid--2">
      <div>
        <p class="eyebrow">Clinical approach</p>
        <h2>Different tools for different people.</h2>
      </div>

      <div>
        <p>
          Maya may incorporate Internal Family Systems concepts, mindfulness,
          somatic awareness, emotionally focused work, and person-centered
          counseling depending on the goals of therapy.
        </p>

        <p>
          These approaches are used flexibly. Therapy can focus on insight,
          coping skills, relationships, emotional patterns, or simply creating
          enough space to understand what needs attention next.
        </p>

        <div class="bio-links">
          <a class="link-arrow" href="/approaches/">
            Explore therapy approaches
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bio-section">
    <div class="container grid grid--2">
      <div>
        <p class="eyebrow">Professional background</p>
        <h2>A fictional clinician created for this demonstration site.</h2>
      </div>

      <div>
        <p>
          Maya Bennett, LPC, is a fictional counselor used to demonstrate how a
          clinician profile can be presented on a professional therapy website.
        </p>

        <p>
          The education, credentials, specialties, and professional history shown
          on a real client website would be replaced with information supplied
          and verified by that clinician.
        </p>

        <p>
          This demonstration intentionally avoids representing the fictional
          clinician as holding certifications, training, or professional history
          that have not actually been established.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tint bio-section">
    <div class="container measure">
      <p class="eyebrow">A personalized process</p>
      <h2>Therapy can reflect what matters to you.</h2>

      <p>
        Clients bring different values, backgrounds, relationships, and life
        experiences into counseling. Those differences can be part of the
        conversation when they are relevant and meaningful to the client.
      </p>

      <div class="bio-links">
        <a class="link-arrow" href="/services/">
          Explore therapy services
        </a>

        <a class="link-arrow" href="/contact/">
          Contact Evergreen Counseling Collective
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .bio-section{
    padding-block:2.75rem
  }

  .bio-intro{
    padding-bottom:2.25rem
  }

  .bio-intro+.bio-section{
    padding-top:2.5rem
  }

  .profile{
    display:grid;
    gap:1.75rem;
    align-items:center
  }

  .photo{
    display:block;
    width:min(68vw,15rem);
    aspect-ratio:35/39;
    overflow:hidden;
    justify-self:center;
    border-radius:12rem 12rem 1rem 1rem;
    background:#dbe5df;
    box-shadow:var(--shadow)
  }

  .photo img{
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center top
  }

  

  

  

  

  .bio-links{
    display:grid;
    gap:.5rem;
    margin-top:1rem
  }

  @media(min-width:48rem){
    .bio-section,
    .bio-intro,
    .bio-intro+.bio-section{
      padding-block:var(--s7)
    }

    .profile{
      grid-template-columns:.8fr 1.2fr;
      gap:2.5rem
    }

    .photo{
      width:min(100%,25rem)
    }
  }
</style>
