---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import {
  personSchema,
  breadcrumbSchema,
  pageSchema,
} from '../../lib/schema';

const crumbs = [
  { label: 'About', href: '/about/' },
  { label: 'Maya Bennett, LPC' },
];
---

<Layout
  title="Maya Bennett, LPC | Fort Collins Counselor"
  description="Meet Maya Bennett, LPC, an EMDRIA Certified Therapist providing individual counseling for adults at Evergreen Counseling Collective in Fort Collins, Colorado."
  schema={pageSchema([
    personSchema('/about/maya-bennett/'),
    breadcrumbSchema(crumbs, Astro.url.pathname),
  ])}
>
  <PageHero
    eyebrow="Your counselor"
    title="Maya Bennett, LPC"
    intro="Maya is a Licensed Clinical Professional Counselor who brings an attentive, practical, and connected presence to individual therapy."
    crumbs={crumbs}
  />

  <section class="section bio-section bio-intro">
    <div class="container profile">
      <picture class="photo">
        <source
          srcset="/images/lisa/maya-bennett-360.webp 360w, /images/lisa/maya-bennett-480.webp 480w, /images/lisa/maya-bennett-700.webp 700w"
          sizes="(min-width: 48rem) 25rem, 15rem"
        />

        <img
          src="/images/lisa/maya-bennett-360.webp"
          width="700"
          height="780"
          loading="lazy"
          decoding="async"
          alt="Maya Bennett, LPC"
        />
      </picture>

      <div>
        <p class="eyebrow">Working with Maya</p>
        <h2>A counselor who pays attention to more than the words alone.</h2>

        <p>
          Maya values honest conversation and a therapeutic relationship where
          clients can speak openly. She listens for what someone is saying
          while also noticing patterns, reactions, and changes that may be
          important to the work.
        </p>

        <p>
          Her counseling style is engaged and collaborative. Rather than
          assuming every person needs the same process, Maya works with clients
          to understand what is happening and decide what may be useful to
          explore.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tint bio-section">
    <div class="container grid grid--2">
      <div>
        <p class="eyebrow">Clinical approaches</p>
        <h2>Several ways of working, selected with care.</h2>
      </div>

      <div>
        <p>
          Depending on a client’s needs and preferences, Maya’s work may
          incorporate EMDR, Internal Family Systems (IFS), Somatic
          Experiencing, Emotionally Focused Therapy (EFT), mindfulness, and
          person-centered counseling.
        </p>

        <p>
          These approaches are tools within therapy rather than requirements.
          Maya considers the focus of counseling, the client’s preferences,
          and what appears appropriate for the work.
        </p>

        <div class="emdr-credential">
          <img
            src="/images/credentials/emdria-certified-therapist.png"
            width="400"
            height="400"
            loading="lazy"
            decoding="async"
            alt="EMDRIA Certified Therapist certification badge"
          />

          <div>
            <strong>EMDRIA Certified Therapist™</strong>
            <p>Maya holds EMDRIA certification as an EMDR therapist.</p>
          </div>
        </div>

        <div class="bio-links">
          <a class="link-arrow" href="/approaches/emdr/">
            Learn about EMDR therapy
          </a>

          <a class="link-arrow" href="/approaches/">
            Explore Maya’s therapy approaches
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bio-section">
    <div class="container grid grid--2">
      <div>
        <p class="eyebrow">Education and background</p>
        <h2>Clinical training alongside decades of mind-body experience.</h2>
      </div>

      <div>
        <p>
          Maya earned a master’s degree in Clinical Mental Health Counseling
          from Palo Alto University.
        </p>

        <p>
          She also brings more than 20 years of experience teaching yoga and
          meditation and holds the E-RYT 500 credential. Her additional
          training includes iRest Yoga Nidra.
        </p>

        <p>
          That background contributes to Maya’s awareness of how stress,
          emotion, attention, and physical experience can interact during
          therapy.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tint bio-section">
    <div class="container measure">
      <p class="eyebrow">Spirituality in therapy</p>
      <h2>Available when it is meaningful to the client.</h2>

      <p>
        Spiritual resources can be incorporated when a client wants them and
        when they are appropriate to the work. Spirituality is not required.
        Maya respects each client’s beliefs, questions, and preferences.
      </p>

      <div class="bio-links">
        <a class="link-arrow" href="/services/">
          Explore therapy services
        </a>

        <a class="link-arrow" href="/contact/">
          Contact Evergreen Counseling Collective
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .bio-section{
    padding-block:2.75rem
  }

  .bio-intro{
    padding-bottom:2.25rem
  }

  .bio-intro+.bio-section{
    padding-top:2.5rem
  }

  .profile{
    display:grid;
    gap:1.75rem;
    align-items:center
  }

  .photo{
    display:block;
    width:min(68vw,15rem);
    aspect-ratio:35/39;
    overflow:hidden;
    justify-self:center;
    border-radius:12rem 12rem 1rem 1rem;
    background:#dbe5df;
    box-shadow:var(--shadow)
  }

  .photo img{
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center top
  }

  .emdr-credential{
    display:flex;
    align-items:center;
    gap:1rem;
    margin:1.5rem 0
  }

  .emdr-credential img{
    width:6.5rem;
    height:6.5rem;
    flex:0 0 auto
  }

  .emdr-credential strong{
    display:block;
    color:var(--ink);
    font-size:.95rem
  }

  .emdr-credential p{
    margin:.25rem 0 0;
    font-size:.9rem;
    line-height:1.5
  }

  .bio-links{
    display:grid;
    gap:.5rem;
    margin-top:1rem
  }

  @media(min-width:48rem){
    .bio-section,
    .bio-intro,
    .bio-intro+.bio-section{
      padding-block:var(--s7)
    }

    .profile{
      grid-template-columns:.8fr 1.2fr;
      gap:2.5rem
    }

    .photo{
      width:min(100%,25rem)
    }
  }
</style>
