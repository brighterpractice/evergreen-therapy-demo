---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import {
  personSchema,
  breadcrumbSchema,
  pageSchema,
} from '../../lib/schema';

const crumbs = [
  { label: 'About', href: '/about/' },
  { label: 'Maya Bennett, LPC' },
];
---

<Layout
  title="Maya Bennett, LPC | Fort Collins Counselor"
  description="Meet Maya Bennett, LPC, a fictional counselor at Evergreen Counseling Collective in Fort Collins, Colorado."
  schema={pageSchema([
    personSchema('/about/maya-bennett/'),
    breadcrumbSchema(crumbs, Astro.url.pathname),
  ])}
>
  <PageHero
    eyebrow="Your counselor"
    title="Maya Bennett, LPC"
    intro="Maya offers individual counseling for adults who want a calm place to slow down, make sense of what has been building, and consider what could shift."
    crumbs={crumbs}
  />

  <section class="section bio-section bio-intro">
    <div class="container profile">
      <picture class="photo">
        <img
          src="/images/demo/clinician-placeholder.svg"
          width="700"
          height="780"
          loading="lazy"
          decoding="async"
          alt="Clinician photo placeholder"
        />
      </picture>

      <div>
        <p class="eyebrow">Working with Maya</p>
        <h2>A steady presence for conversations that need a little room.</h2>

        <p>
          Maya’s style is calm, attentive, and unhurried. She is interested in
          what is happening underneath the obvious problem as well as what may
          help make everyday life feel more manageable.
        </p>

        <p>
          Sessions can include reflection, noticing patterns, trying practical
          shifts, or simply staying with an experience long enough for it to
          make more sense. The pace is meant to support the work rather than
          push it.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tint bio-section" id="clinical-approach">
    <div class="container grid grid--2">
      <div>
        <p class="eyebrow">Ways Maya may work</p>
        <h2>More than one way to pay attention.</h2>
      </div>

      <div>
        <p>
          Maya may draw from Internal Family Systems concepts, mindfulness,
          somatic awareness, emotionally focused work, and person-centered
          counseling. Those ideas can offer different ways to notice what is
          happening in thoughts, emotions, relationships, and the body.
        </p>

        <p>
          The approach can shift as the work develops. Maya may spend more time
          with one framework, combine several, or keep the focus on ordinary
          conversation when that is what feels most useful.
        </p>

        <p>
          Clients are encouraged to ask questions and say when something feels
          helpful, confusing, or simply not like a fit.
        </p>

        <div class="bio-links">
          <a class="link-arrow" href="/services/">
            See areas of support
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bio-section">
    <div class="container grid grid--2">
      <div>
        <p class="eyebrow">About this demo profile</p>
        <h2>Maya is a fictional clinician created for this website demonstration.</h2>
      </div>

      <div>
        <p>
          Maya Bennett, LPC, is not a real provider. Her profile shows how a
          smaller counseling practice can introduce a clinician, describe the
          feel of the work, and give visitors enough information to decide
          whether they want to learn more.
        </p>

        <p>
          A real practice website would replace these demonstration details with
          verified education, credentials, specialties, and professional history.
        </p>

        <p>
          No fictional certification, license history, or training is presented
          here as a real credential.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tint bio-section">
    <div class="container measure">
      <p class="eyebrow">What can belong in the room</p>
      <h2>The conversation can include more than the problem that brought you in.</h2>

      <p>
        Relationships, responsibilities, identity, health, environment, and the
        way you have learned to cope can all matter when they help explain what
        life feels like now.
      </p>

      <div class="bio-links">
        <a class="link-arrow" href="/services/">
          Explore Evergreen services
        </a>

        <a class="link-arrow" href="/contact/">
          Contact Evergreen
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .bio-section{
    padding-block:2.75rem
  }

  .bio-intro{
    padding-bottom:2.25rem
  }

  .bio-intro+.bio-section{
    padding-top:2.5rem
  }

  .profile{
    display:grid;
    gap:1.75rem;
    align-items:center
  }

  .photo{
    display:block;
    width:min(68vw,15rem);
    aspect-ratio:35/39;
    overflow:hidden;
    justify-self:center;
    border-radius:12rem 12rem 1rem 1rem;
    background:#dbe5df;
    box-shadow:var(--shadow)
  }

  .photo img{
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center top
  }

  .bio-links{
    display:grid;
    gap:.5rem;
    margin-top:1rem
  }

  @media(min-width:48rem){
    .bio-section,
    .bio-intro,
    .bio-intro+.bio-section{
      padding-block:var(--s7)
    }

    .profile{
      grid-template-columns:.8fr 1.2fr;
      gap:2.5rem
    }

    .photo{
      width:min(100%,25rem)
    }
  }
</style>
