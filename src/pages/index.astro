---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { appointmentUrl } from '../data/site';
import { homepageServices } from '../data/services';
import {
 organizationSchema,
 websiteSchema,
 pageSchema,
} from '../lib/schema';
---

<Layout
 title="Evergreen Counseling Collective | Therapy in Fort Collins, Colorado"
 description="Individual counseling in Fort Collins, Colorado for adults navigating anxiety, burnout, relationship patterns, grief, major transitions, and difficult life experiences."
 schema={pageSchema([organizationSchema, websiteSchema])}
>
 <section class="hero">
 <div class="container hero-grid">
 <div class="hero-content">
 <p class="eyebrow">
 Evergreen Counseling Collective · Fort Collins, Colorado
 </p>

 <h1>
 A quieter place to sort through what feels tangled.
 </h1>

 <p class="hero-copy">
 Individual counseling for adults who want space to slow down, understand
 what has been weighing on them, and reconnect with a steadier sense of
 direction.
 </p>
 </div>

 <picture class="hero-portrait">
 <source
 srcset="/images/demo/clinician-placeholder.svg"
 sizes="(min-width: 48rem) 22rem, 12.5rem"
 />
 <img
 src="/images/demo/clinician-placeholder.svg"
 width="700"
 height="780"
 loading="eager"
 fetchpriority="high"
 decoding="async"
 alt="Clinician photo placeholder"
 />
 </picture>

 <div class="hero-actions">
 <Button href={appointmentUrl} tracking="request-appointment">
 Request an appointment
 </Button>
 </div>
 </div>
 </section>

 <section class="section hp-intro">
 <div class="container grid grid--2 intro">
 <p class="eyebrow">Room to pause</p>

 <div>
 <h2>Slow down long enough to notice what needs care.</h2>

 <p>
 Some seasons are loud and obvious. Others simply leave you feeling worn
 down, disconnected, or unsure of what comes next. Counseling can offer a
 calmer place to listen to what has been building beneath the surface.
 </p>
 </div>
 </div>
 </section>

 <section class="section video-intro-section" aria-labelledby="video-intro-heading">
 <div class="container video-intro-grid">
 <div class="video-intro-copy">
 <p class="eyebrow">Video introduction example</p>
 <h2 id="video-intro-heading">A short hello can make reaching out feel easier.</h2>
 <p>
 A practice can place a welcome, introduction, or educational YouTube video
 directly on the website so visitors can watch without leaving the page.
 </p>
 <p class="video-demo-note">
 This demo player uses YouTube’s privacy-enhanced embed domain and loads lazily.
 A client site would use the practice’s own YouTube video.
 </p>
 </div>

 <div class="video-frame-shell">
 <div class="video-frame">
 <iframe
 src="https://www.youtube-nocookie.com/embed/M7lc1UVf-VE?rel=0"
 title="YouTube video embed demonstration"
 loading="lazy"
 referrerpolicy="strict-origin-when-cross-origin"
 allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
 allowfullscreen
 ></iframe>
 </div>
 <p class="video-caption">Example embedded YouTube player</p>
 </div>
 </div>
 </section>

 <section class="section section--tint hp-services">
 <div class="container">
 <p class="eyebrow">Areas of support</p>
 <h2 class="measure">
 Support for the seasons that ask more of you.
 </h2>

 <div class="grid grid--3 top-space">
 {
 homepageServices.map((service) =>
 service.hasDetailPage ? (
 <a
 class="card service-link"
 href={service.href}
 aria-label={`Learn more about ${service.title}`}
 data-bs-analytics-event="service_click" data-bs-content-key={service.slug}
 >
 <h3>{service.title}</h3>
 <p>{service.homeDescription}</p>
 </a>
 ) : (
 <article class="card">
 <h3>{service.title}</h3>
 <p>{service.homeDescription}</p>
 </article>
 )
 )
 }
 </div>

 <a class="link-arrow hp-services-link" href="/services/">
 Explore all services
 </a>
 </div>
 </section>

 <section class="section hp-approach">
 <div class="container grid grid--2">
 <div>
 <p class="eyebrow">How Maya works</p>
 <h2>Thoughtful therapy does not have to feel complicated.</h2>
 </div>

 <div>
 <p>
 Maya brings together relational counseling, body awareness, mindfulness,
 and other approaches in a way that stays responsive to the person in front
 of her. The process can be reflective, practical, or both.
 </p>

 <p>
 You do not have to arrive knowing which method fits you. The work can unfold
 gradually, with room to notice what feels useful and what deserves more time.
 </p>

 <div class="hp-approach-links">
 <a
 class="link-arrow"
 href="/about/maya-bennett/"

 >
 Learn more about Maya’s approach
 </a>
 </div>
 </div>
 </div>
 </section>

 <section class="section about-band">
 <div class="container about-band-inner">
 <p class="eyebrow">Meet Maya Bennett, LPC</p>

 <h2 class="measure">
 Steady presence, honest conversation, room to reflect.
 </h2>

 <p class="measure">
 Maya works with adults in individual counseling and brings a calm,
 attentive style to the therapy room. Her focus is less on rushing toward an
 answer and more on helping clients understand what is happening with enough
 clarity to choose what comes next.
 </p>

 <a class="link-arrow" href="/about/maya-bennett/">
 Get to know Maya
 </a>
 </div>
 </section>

 <section class="section hp-steps">
 <div class="container">
 <p class="eyebrow">Getting started</p>
 <h2>A simple path into counseling.</h2>

 <ol class="steps">
 <li>
 <span>01</span>
 <div>
 <h3>Reach out</h3>
 <p>Send an appointment request when you are ready to begin.</p>
 </div>
 </li>

 <li>
 <span>02</span>
 <div>
 <h3>Check the fit</h3>
 <p>
 Make sure the practice and Maya’s way of working feel right for what you
 are looking for.
 </p>
 </div>
 </li>

 <li>
 <span>03</span>
 <div>
 <h3>Handle the details</h3>
 <p>
 Complete the needed information through the secure client system.
 </p>
 </div>
 </li>

 <li>
 <span>04</span>
 <div>
 <h3>Begin where you are</h3>
 <p>
 Your first session can start with whatever feels most present that day.
 </p>
 </div>
 </li>
 </ol>
 </div>
 </section>

 <section class="section section--tint hp-location">
 <div class="container grid grid--2">
 <div>
 <p class="eyebrow">Fort Collins, Colorado</p>
 <h2>Rooted in Northern Colorado.</h2>
 </div>

 <div>
 <p>
 Evergreen Counseling Collective is based in Fort Collins and welcomes adults
 from Loveland, Windsor, Timnath, Wellington, Greeley, and nearby communities.
 </p>

 <a class="link-arrow" href="/contact/">
 Contact Evergreen
 </a>
 </div>
 </div>
 </section>

 <section class="section section--dark">
 <div class="container final">
 <div>
 <p class="eyebrow">When you are ready</p>
 <h2>See whether Evergreen feels like a place you could settle in and talk.</h2>
 </div>

 <Button
 href={appointmentUrl}
 variant="light"
 tracking="request-appointment"
 >
 Request an appointment
 </Button>
 </div>
 </section>
</Layout>

<style>
 .hero{
 overflow:hidden;
 padding:3.5rem 0;
 background:linear-gradient(135deg,var(--cream),#edf1ec)
 }

 .hero-grid{
 display:grid;
 gap:1.5rem;
 align-items:center
 }

 .hero-copy{
 max-width:39rem;
 margin-bottom:1.35rem;
 font-size:var(--lg);
 line-height:1.55
 }

 .hero-portrait{
 display:block;
 width:min(52vw,12.5rem);
 aspect-ratio:35/39;
 overflow:hidden;
 justify-self:center;
 border-radius:50% 50% 1rem 1rem;
 background:#b9c9c0;
 box-shadow:var(--shadow)
 }

 .hero-portrait img{
 width:100%;
 height:100%;
 object-fit:cover;
 object-position:center top
 }

 .intro>.eyebrow{
 padding-top:.2rem
 }

 .video-intro-section{
 border-block:1px solid rgba(41,72,63,.08);
 background:#f7f4ec
 }

 .video-intro-grid{
 display:grid;
 gap:2rem;
 align-items:center
 }

 .video-intro-copy{
 max-width:34rem
 }

 .video-demo-note,
 .video-caption{
 color:#66766f;
 font-size:.88rem
 }

 .video-demo-note{
 margin-top:1rem
 }

 .video-frame-shell{
 width:100%;
 max-width:42rem;
 justify-self:center
 }

 .video-frame{
 position:relative;
 width:100%;
 aspect-ratio:16/9;
 overflow:hidden;
 border:1px solid rgba(41,72,63,.12);
 border-radius:1.2rem;
 background:#203f38;
 box-shadow:var(--shadow)
 }

 .video-frame iframe{
 position:absolute;
 inset:0;
 width:100%;
 height:100%;
 border:0
 }

 .video-caption{
 margin:.7rem 0 0;
 text-align:center
 }

 .top-space{
 margin-top:1.5rem
 }

 .hp-services-link{
 display:inline-flex;
 margin-top:1.5rem
 }

 .section-heading,
 .final{
 display:flex;
 flex-wrap:wrap;
 align-items:end;
 justify-content:space-between;
 gap:1.15rem;
 margin-bottom:1.5rem
 }

 .about-band{
 background:#e6ece7
 }

 .about-band-inner{
 max-width:40rem;
 margin-inline:auto;
 text-align:center
 }

 .about-band-inner .link-arrow{
 display:inline-block
 }

 .hp-approach-links{
 display:grid;
 gap:.5rem;
 margin-top:1rem
 }

 .steps{
 display:grid;
 gap:.5rem;
 margin:1.5rem 0 0;
 padding:0;
 list-style:none
 }

 .steps li{
 display:flex;
 gap:1rem;
 padding:1.25rem 0;
 border-top:1px solid var(--sand)
 }

 .steps span{
 color:var(--clay-text);
 font-size:.8rem;
 font-weight:800
 }

 .steps h3{
 margin-bottom:.35rem
 }

 .final{
 margin-bottom:0
 }

 .final h2{
 max-width:20ch
 }

 @media(min-width:48rem){
 .hero{
 padding:clamp(3.5rem,8vw,6.5rem) 0
 }

 .hero-grid{
 grid-template-columns:1.25fr .75fr;
 grid-template-areas:
 "content portrait"
 "actions portrait";
 column-gap:3rem;
 row-gap:1.5rem
 }

 .hero-copy{
 margin-bottom:1.5rem;
 line-height:inherit
 }

 .hero-content{
 grid-area:content
 }

 .hero-actions{
 grid-area:actions
 }

 .hero-portrait{
 grid-area:portrait;
 width:min(100%,22rem);
 justify-self:end
 }

 .intro>.eyebrow{
 padding-top:.4rem
 }

 .video-intro-grid{
 grid-template-columns:.8fr 1.2fr;
 gap:3rem
 }

 .top-space{
 margin-top:2rem
 }

 .section-heading,
 .final{
 gap:1.5rem;
 margin-bottom:2rem
 }

 .steps{
 grid-template-columns:repeat(4,1fr);
 gap:1rem;
 margin-top:2rem
 }

 .steps li{
 display:block;
 padding:1.5rem 0
 }

 .steps span{
 display:block;
 margin-bottom:1.2rem
 }

 .hp-intro{
 padding-block:4rem
 }

 .video-intro-section{
 padding-block:4.75rem
 }

 .hp-intro .container{
 grid-template-columns:1fr;
 justify-items:center;
 text-align:center;
 max-width:30rem;
 margin-inline:auto
 }

 .hp-services{
 padding-block:5rem
 }

 .hp-approach{
 padding-block:4.25rem
 }

 .hp-approach .container{
 grid-template-columns:1fr;
 justify-items:center;
 text-align:center;
 max-width:38rem;
 margin-inline:auto
 }

 .about-band{
 padding-block:4.25rem
 }

 .hp-steps{
 padding-block:5rem
 }

 .hp-location{
 padding-block:4.5rem
 }
 }
</style>
